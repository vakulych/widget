GEMINI_API_KEY=YOUR_KEY_HERE

GEMINI_MODEL=gemini-3.5-flash-lite

FEED_URL=https://skay.ua/modules/skayproductsuploading/export/skay_feed_all_products.xml

PORT=3000

ALLOWED_ORIGINS=https://skay.ua,https://www.skay.ua

BRAVE_API_KEY=

# Hybrid search: semantic vectors improve the ordering of results after the
# catalogue has applied exact filters (model, price, availability, attributes).
EMBEDDINGS_ENABLED=true


EMBEDDING_MODEL=gemini-embedding-001


EMBEDDING_DIM=256


EMBEDDING_BATCH_DELAY_MS=200


RERANK_ENABLED=false


SELF_CHECK_ENABLED=false
